<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Mist TV theme — extends Leanback for proper TV UI behavior -->
    <style name="Theme.MistTV" parent="Theme.Leanback">
        <item name="android:windowBackground">@drawable/mist_background</item>
        <item name="android:fontFamily">@font/geistregular</item>
        <item name="android:colorPrimary">@color/mist_brand</item>
        <item name="android:colorAccent">@color/mist_accent</item>
        <item name="android:textColorPrimary">@color/mist_text_primary</item>
        <item name="android:textColorSecondary">@color/mist_text_secondary</item>
        <item name="browseTitleTextStyle">@style/MistTitleText</item>
        <item name="imageCardViewTitleStyle">@style/MistCardTitleText</item>
        <item name="imageCardViewContentStyle">@style/MistCardContentText</item>
    </style>

    <!-- Playback activity: pure black, no title bar -->
    <style name="Theme.MistTV.Playback" parent="Theme.MistTV">
        <item name="android:fontFamily">@font/geistregular</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#000000</item>
    </style>

    <!-- Browse screen title -->
    <style name="MistTitleText" parent="Widget.Leanback.Title.Text">
        <item name="android:fontFamily">@font/geistbold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">44sp</item>
    </style>

    <!-- Channel card title -->
    <style name="MistCardTitleText" parent="Widget.Leanback.ImageCardView.TitleStyle">
        <item name="android:fontFamily">@font/geistbold</item>
    </style>

    <!-- Channel card description/content -->
    <style name="MistCardContentText" parent="Widget.Leanback.ImageCardView.ContentStyle">
        <item name="android:fontFamily">@font/geistregular</item>
    </style>
</resources>